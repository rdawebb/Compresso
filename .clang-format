BasedOnStyle: LLVM
# CPython macros that end without a semicolon; otherwise the following line
# is formatted as a continuation of them
StatementMacros:
  - Py_BEGIN_ALLOW_THREADS
  - Py_END_ALLOW_THREADS
  - Py_BLOCK_THREADS
  - Py_UNBLOCK_THREADS
  - PyObject_HEAD
  - PyObject_VAR_HEAD
# Python.h sets feature-test macros, so it must precede every system header
IncludeCategories:
  - Regex: '^<Python\.h>$'
    Priority: -1
  - Regex: '^"'
    Priority: 1
  - Regex: ".*"
    Priority: 2
